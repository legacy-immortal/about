{
   "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true,
      "jsx": "react-jsx",
      "jsxImportSource": "react",
      "allowImportingTsExtensions": true,
      "baseUrl": ".",
      "ignoreDeprecations": "6.0",
      "paths": {
         "~/*": ["./src/*"]
      }
   },
   "include": ["src/**/*"]
}