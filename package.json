{
  "name": "about",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist --nojekyll",
    "test:midscene": "bun test tests/midscene/suites",
    "test:personas": "CAMOUFOX_MIDSCENE_INTEGRATION=1 bun test tests/midscene/suites/persona-walkthroughs.spec.ts",
