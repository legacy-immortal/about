# Legacy Immortal — about site
#
# Set VITE_API_BASE when deploying with a connected invitation backend.
# Leave it blank for a static GitHub Pages deploy: the waitlist CTA will degrade
# gracefully with a clear message instead of a cryptic fetch error.
VITE_API_BASE=

# Enable the early access / alpha invitation flow (section, nav link, and form).
# Defaults to enabled when unset. Set to "false" to disable.
VITE_EARLY_ACCESS_ENABLED=
